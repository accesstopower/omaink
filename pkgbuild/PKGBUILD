pkgname=omaink
pkgver=0.1.0
pkgrel=1
pkgdesc='Draw over your screen from a mouse, pen tablet or iPad'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'layer-shell-qt' 'grim')
optdepends=('qrencode: QR code for pairing a tablet')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omaink "$pkgdir/usr/bin/omaink"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omaink.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaink.svg"
  install -Dm644 "$startdir/omaink.desktop" "$pkgdir/usr/share/applications/omaink.desktop"
}
